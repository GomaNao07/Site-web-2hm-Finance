# ==============================================================================
# 2HM FINANCE - CONFIGURATION APACHE (.htaccess)
# Optimization SEO, Routage SPA, Cache, Compressions & Sécurité
# ==============================================================================

# 1. ENCODAGE DES CARACTÈRES
AddDefaultCharset UTF-8

# 2. OPTION ET SUIVI DES LIENS SYMBOLIQUES
Options -Indexes +FollowSymLinks

# 3. REÉCRITURE D'URL POUR ROUTAGE SPA (React Router)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirection vers HTTPS (optionnel, décommenter si certificat SSL actif)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Redirection du sous-domaine www vers domaine apex (ou inversement)
    # RewriteCond %{HTTP_HOST} ^www\.2hmfinance\.com [NC]
    # RewriteRule ^(.*)$ https://2hmfinance.com/$1 [L,R=301]

    # Si le fichier ou le dossier demandé existe réellement, servir directement
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Sinon, tout rediriger vers index.html pour la gestion par React Router
    RewriteRule ^ index.html [L]
</IfModule>

# 4. COMPRESSION GZIP / MOD_DEFLATE (Performance & SEO)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json application/xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 5. CACHE DE NAVIGATEUR ET EXPIRATION DES ASSETS (mod_expires)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML (pas de cache long pour maj immédiate de la SPA)
    ExpiresByType text/html "access plus 0 seconds"

    # Fichiers CSS et JavaScript (Hachés par Vite build)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Images, WebP, SVG et Favicon
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Polices web
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 6. EN-TÊTES DE SÉCURITÉ (mod_headers)
<IfModule mod_headers.c>
    # Protection contre le MIME-sniffing
    Header set X-Content-Type-Options "nosniff"

    # Protection contre le Clickjacking
    Header set X-Frame-Options "SAMEORIGIN"

    # Protection XSS pour anciens navigateurs
    Header set X-XSS-Protection "1; mode=block"

    # Politiques de référent (SEO & Sécurité)
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Cache Control pour assets immuables (images, JS bundle)
    <FilesMatch "\.(js|css|png|jpg|jpeg|gif|webp|svg|woff|woff2|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Cache Control pour le fichier HTML principal
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
